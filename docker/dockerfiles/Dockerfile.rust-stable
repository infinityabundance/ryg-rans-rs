# syntax=docker/dockerfile:1
# Current stable toolchain (matches the host/reference build toolchain).  The
# MSRV (1.85) is covered by the dedicated `msrv` job; this job runs the full
# workspace test suite on the project's actual build toolchain, where the
# AVX-512 stdarch intrinsics used by the disassembly courts are stable.
FROM rust:1.96-slim-bookworm AS rust-stable

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

LABEL org.infinityabundance.project=ryg-rans-rs
LABEL org.infinityabundance.purpose=forensic-parity-court
LABEL org.infinityabundance.managed-by=ryg-rans-rs-xtask
