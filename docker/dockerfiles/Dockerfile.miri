# syntax=docker/dockerfile:1
FROM rust:1.85-slim-bookworm AS miri

# Install nightly toolchain with miri component
# Pin to a nightly version known to have miri available (nightly-2025-11-25)
# On disk-constrained systems, this uses ~1.5GB for the nightly toolchain
RUN rustup toolchain install nightly-2025-11-25 --component miri && \
    rustup target add x86_64-unknown-linux-gnu --toolchain nightly-2025-11-25 && \
    rustup default nightly-2025-11-25

# Smoke test: verify miri is available
RUN cargo miri --version

LABEL org.infinityabundance.project=ryg-rans-rs
LABEL org.infinityabundance.purpose=forensic-parity-court
LABEL org.infinityabundance.managed-by=ryg-rans-rs-xtask
