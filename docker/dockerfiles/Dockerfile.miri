# syntax=docker/dockerfile:1
FROM rust:1.85-slim-bookworm AS miri

# Nightly toolchain with miri is installed at runtime (not build time)
# to avoid exhausting disk space during image build.
# The runtime install uses CARGO_HOME volume on the external drive.

LABEL org.infinityabundance.project=ryg-rans-rs
LABEL org.infinityabundance.purpose=forensic-parity-court
LABEL org.infinityabundance.managed-by=ryg-rans-rs-xtask
